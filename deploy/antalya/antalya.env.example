# Copy to antalya.env and fill in. Nothing here is secret: the database password is asked for
# when the script runs and goes straight into Secret Manager.

# GCP project id (not the name), with billing on
PROJECT_ID=

REGION=asia-southeast1

# Supabase: Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Supabase: Connect -> "Session pooler" (Cloud Run has no IPv6, so not the direct connection).
# Only the host, e.g. aws-0-ap-southeast-1.pooler.supabase.com
SUPABASE_POOLER_HOST=
