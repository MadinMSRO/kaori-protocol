# Private CPU CLIP generalist for Cloud Run service `kaori-generalist`.
FROM python:3.12-slim

WORKDIR /app

COPY packages/kaori-truth/src/kaori_truth /app/kaori_truth
COPY packages/kaori-flow/src/kaori_flow /app/kaori_flow
COPY packages/kaori-api/src/kaori_api /app/kaori_api
COPY packages/kaori-spec/schemas /app/packages/kaori-spec/schemas

ENV KAORI_CLIP_CACHE=/app/.cache/open_clip

RUN pip install --no-cache-dir \
        "fastapi>=0.100.0" \
        "uvicorn[standard]>=0.22.0" \
        "pydantic>=2.0.0" \
        "pyyaml>=6.0" \
        "h3>=4.0.0" \
        "Pillow>=12.3.0" \
        "open-clip-torch>=3.3.0" \
        "torch>=2.13.0" \
        "torchvision>=0.28.0" \
    && mkdir -p "$KAORI_CLIP_CACHE" \
    && python -c "import open_clip; open_clip.create_model_and_transforms('ViT-B-32', pretrained='openai', device='cpu', cache_dir='$KAORI_CLIP_CACHE')" \
    && useradd --create-home --uid 10001 kaori \
    && chown -R kaori:kaori /app

ENV PYTHONPATH=/app
ENV KAORI_SCHEMA_PATH=/app/packages/kaori-spec/schemas
ENV PYTHONUNBUFFERED=1

EXPOSE 8080

USER kaori

CMD ["sh", "-c", "uvicorn kaori_api.generalist_app:app --host 0.0.0.0 --port ${PORT:-8080}"]
