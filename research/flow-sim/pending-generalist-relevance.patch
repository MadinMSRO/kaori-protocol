+    @staticmethod
+    def _relevance_by_observation(
+        request: ValidatorRequest,
+        refs: List[EvidenceRef],
+        relevance: Sequence[float],
+    ) -> Dict[str, float]:
+        """Mean relevance of each observation's own evidence."""
+        by_uri: Dict[str, List[float]] = {}
+        for ref, score in zip(refs, relevance):
+            by_uri.setdefault(ref.uri, []).append(float(score))
+        out: Dict[str, float] = {}
+        for observation in request.observations:
+            scores = [s for ref in observation.evidence_refs for s in by_uri.get(ref.uri, [])]
+            if scores:
+                out[str(observation.observation_id)] = round(sum(scores) / len(scores), 6)
+        return out
+
+    @staticmethod
+    def relevance_threshold(config: dict) -> float:
+        return float(((config.get("evidence_similarity") or {}).get("embedding") or {}).get("similarity_threshold"))
+
