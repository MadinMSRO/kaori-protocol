# Kaori Protocol — Environment Variables
# Copy this file to .env and fill in your values
# Do not provision Cloud SQL, GCS, or Cloud Run from this repo.

# =============================================================================
# API Authentication
# =============================================================================

# Verify Bearer via GET {SUPABASE_URL}/auth/v1/user (no JWT secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# =============================================================================
# Environment
# =============================================================================

# development | staging | production
# production refuses to boot without DATABASE_URL
KAORI_ENVIRONMENT=development

# =============================================================================
# Database — Cloud SQL Postgres. Schema kaori: signals + observations + artifacts
# =============================================================================

# Required when KAORI_ENVIRONMENT=production. Optional locally (in-memory stores).
# DATABASE_URL=<Cloud SQL Postgres URL as kaori_runtime>
# Do not put signals or truth_states in public (not public.truths).
# Apply DDL separately as the migration owner:
#   python -m kaori_db.migrate
# The API runtime must not call ensure_schema() and does not need CREATE.

# Dedicated TruthState HMAC — required whenever DATABASE_URL is Postgres.
# Must not equal the repository development key or KAORI_VALIDATOR_SIGNING_KEY.
# KAORI_SIGNING_KEY=replace-with-truthstate-secret
# KAORI_SIGNING_KEY_ID=msro-kaori-prod-1

# ClaimType YAML root (defaults to packages/kaori-spec/schemas)
# KAORI_SCHEMA_PATH=packages/kaori-spec/schemas

# Private Cloud Run generalist URL (only kaori-api invokes it)
# KAORI_GENERALIST_URL=https://kaori-generalist-<hash>-as.a.run.app
# Generalist request HMAC — distinct from KAORI_SIGNING_KEY
# KAORI_VALIDATOR_SIGNING_KEY=replace-with-a-secret

# =============================================================================
# Private observations bucket (required when DATABASE_URL is set)
# =============================================================================

# KAORI_OBSERVATIONS_BUCKET=msro-kaori-observations
# KAORI_MAX_EVIDENCE_BYTES=26214400

# =============================================================================
# Validators
# =============================================================================

# The V4 validator is the open CLIP generalist. It uses Cloud Run CPU and
# does not use a specialist, chat LLM, Vertex AI, or GPU.
