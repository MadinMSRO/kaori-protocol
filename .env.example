# Kaori Protocol — Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# API Authentication
# =============================================================================

# Verify Bearer via GET {SUPABASE_URL}/auth/v1/user (no JWT secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Comma-separated list of valid API keys for service-to-service auth
KAORI_API_KEYS=key1,key2,key3

# =============================================================================
# Environment
# =============================================================================

# Environment name: development, staging, production
KAORI_ENVIRONMENT=development

# CORS allowed origins (comma-separated, or * for all)
KAORI_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting (requests per minute)
KAORI_RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# Database — Cloud SQL Postgres. Schema kaori: signals + truth_states
# =============================================================================

# DATABASE_URL=<Cloud SQL Postgres URL>
# Do not put signals or truth_states in public (not public.truths).
# ensure_schema() creates schema kaori, kaori.signals, kaori.truth_states.

# ClaimType YAML root (defaults to packages/kaori-spec/schemas)
# KAORI_SCHEMA_PATH=packages/kaori-spec/schemas

# Private Cloud Run generalist URL (only kaori-api invokes it)
# KAORI_GENERALIST_URL=https://kaori-generalist-<hash>-as.a.run.app
# Shared HMAC secret supplied from Secret Manager in production
# KAORI_VALIDATOR_SIGNING_KEY=replace-with-a-secret

# =============================================================================
# Cloud Storage (Optional - for evidence files)
# =============================================================================

# GCS_BUCKET=kaori-evidence
# GCS_CREDENTIALS_PATH=/path/to/service-account.json

# =============================================================================
# Validators
# =============================================================================

# The V4 validator is the open CLIP generalist. It uses Cloud Run CPU and
# does not use a specialist, chat LLM, Vertex AI, or GPU.
